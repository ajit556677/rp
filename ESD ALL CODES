    MOV A,#38H  ;
    ACALL LCD_CMD;

    MOV A,#0EH      ; 
    ACALL LCD_CMD;

    MOV A,#01H      ; 
    ACALL LCD_CMD;

    MOV A,#06H      ; 
    ACALL LCD_CMD;
    RET;
LCD_CMD:
    MOV P1,A;
    CLR RS;
    CLR RW;
    SETB EN;
    ACALL DELAY;
    CLR EN;
    RET;
LCD_DATA:
    MOV P1,A;
    SETB RS;
    CLR RW;
    SETB EN;
    ACALL DELAY;
    CLR EN;
    RET;
DELAY:
    MOV R2,#255;
D1: MOV R1,#255;
D2: DJNZ R1,D2;
    DJNZ R2,D1;
    RET;
END

ARM microcontroller  for arithmetic and data manipulation
AREA DATA_OP, CODE, READONLY
        ENTRY

START
        MOV     R0, #12      ; First number (1100)
        MOV     R1, #10      ; Second number (1010)

        MOV     R2, R0       ; Data transfer
        AND     R3, R0, R1   ; Bitwise AND
        ORR     R4, R0, R1   ; Bitwise OR
        EOR     R5, R0, R1   ; Bitwise XOR
        MOV     R6, R0, LSL #1 ; Shift left by 1 bit

STOP
        B       STOP

        END
Led based on arm microcontroller

#include <LPC21xx.H>                       /* LPC21xx definitions  */
void ledonoff(void);
void delay(void);
int main()
{
	IODIR1 = 0xFFFFFFFF;               // Make port bits P1.16......P1.23 as output
	IODIR0 = 0xFFFFFFFF;    
	ledonoff();			               // Initialize LED
    return 0;

}

void ledonoff(void)
{
	while(1)
	{
		IOSET1 = 0xFFFFFFFF;				//Make port bits high
		IOSET0 = 0xFFFFFFFF;				
		delay();  
		IOCLR1 = 0xFFFFFFFF;				//Make port bits low
		IOCLR0 = 0xFFFFFFFF;
		delay();
					
}
}
void delay(void)
{
	int i;
	char k;
	for(k=0;k<=8;k++)
	{
		for(i=0;i<=400000;i++) ;
}
}
